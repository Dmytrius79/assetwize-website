---
// Symbolen van de drie perspectieven — port van components/brand/PerspectiveIcons.tsx (Compass-app).
interface Props { soort: 'koers' | 'controle' | 'groei'; size?: number }
const { soort, size = 32 } = Astro.props;
const F = { forest500: '#3D7A5A', forest700: '#1A4A35', forest600: '#2D6A4F', forest100: '#EDF4F0', accent: '#C8EED8' };
---
<svg width={size} height={size} viewBox="0 0 32 32" fill="none" aria-hidden="true">
  <circle cx="16" cy="16" r="15" stroke={F.forest600} stroke-width="1.5" fill={F.forest100} />
  {soort === 'koers' && (
    <Fragment>
      <g transform="rotate(35 16 16)">
        <polygon points="16,5 19,16 13,16" fill={F.forest700} />
        <polygon points="16,27 13,16 19,16" fill={F.forest500} />
      </g>
      <circle cx="16" cy="16" r="1.8" fill={F.accent} stroke={F.forest700} stroke-width="0.8" />
    </Fragment>
  )}
  {soort === 'controle' && (
    <Fragment>
      <circle cx="16" cy="16" r="4" stroke={F.forest700} stroke-width="1.5" fill="none" />
      <path d="M16 7v2M16 23v2M7 16h2M23 16h2M9.5 9.5l1.4 1.4M21.1 21.1l1.4 1.4M9.5 22.5l1.4-1.4M21.1 10.9l1.4-1.4" stroke={F.forest700} stroke-width="1.5" stroke-linecap="round" />
    </Fragment>
  )}
  {soort === 'groei' && (
    <Fragment>
      <polyline points="8,22 14,14 18,18 24,10" stroke={F.forest700} stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
      <polyline points="20,10 24,10 24,14" stroke={F.forest700} stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
    </Fragment>
  )}
</svg>
