              <div>
                <p style="font-size:12px; font-weight:600; color:#1C0F07; margin-bottom:2px;">{level.titel}</p>
                <p style="font-size:12px; color:#6b7280; line-height:1.5;">{level.tekst}</p>
              </div>
            </div>
          ))}
        </div>
      </div>

      <p class="mt-6 text-xs" style="color:#9ca3af; font-weight:400;">
