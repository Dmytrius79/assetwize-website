---
import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../styles/global.css';

// Zeven domeinen: één bron voor het diagram (desktop) en de lijst (mobiel)
const domeinen = [
  { code: 'T5', cx: 340, cy: 140, lx: 340, ly: 97, anker: 'middle', regels: ["Governance & Eigenaarschap"] },
  { code: 'T1', cx: 232, cy: 208, lx: 196, ly: 181, anker: 'end', regels: ["Risico, Veiligheid", "& Compliance"] },
  { code: 'T2', cx: 448, cy: 208, lx: 484, ly: 181, anker: 'start', regels: ["Betrouwbaarheid", "& Continuïteit"] },
  { code: 'T7', cx: 198, cy: 308, lx: 162, ly: 291, anker: 'end', regels: ["Organisatie, Mensen", "& Uitvoerbaarheid"] },
  { code: 'T3', cx: 482, cy: 308, lx: 518, ly: 291, anker: 'start', regels: ["Waarde, Lifecycle", "& Investeringen"] },
  { code: 'T6', cx: 256, cy: 392, lx: 220, ly: 420, anker: 'end', regels: ["Toekomstvastheid", "& Verandervermogen"] },
  { code: 'T4', cx: 424, cy: 392, lx: 460, ly: 420, anker: 'start', regels: ["Besluitvorming", "& Stuurinformatie"] },
];
---
<BaseLayout
  title="Atlas — referentiekader voor asset governance"
  description="Waar ISO 55000 stopt, begint Atlas. Een uitgewerkt governance-systeem met frameworks, blueprints en implementatierichtlijnen voor asset-intensieve organisaties."
>

  <!-- ① HERO -->
  <section class="bg-white border-b border-aw-line pt-28 pb-20">
    <div class="aw-container">
      <div class="flex items-center gap-4 mb-10 pb-8"
           style="border-bottom:0.5px solid var(--aw-line);">
        <svg viewBox="0 0 40 40" width="52" height="52" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <circle cx="20" cy="20" r="16" fill="none" stroke="#7A4F1E" stroke-width="1.5"/>
          <line x1="20" y1="4"  x2="20" y2="36" stroke="#7A4F1E" stroke-width="1.5"/>
          <ellipse cx="20" cy="20" rx="8" ry="16" fill="none" stroke="#7A4F1E" stroke-width="1" opacity="0.5"/>
          <line x1="4"  y1="20" x2="36" y2="20" stroke="#7A4F1E" stroke-width="0.5" opacity="0.4"/>
        </svg>
        <div style="border-left:0.5px solid var(--aw-line); padding-left:12px;">
          <div style="font-size:26px; font-weight:500; color:#1C0F07; letter-spacing:0.02em; line-height:1.1;">Atlas</div>
          <div style="font-size:12px; font-weight:500; letter-spacing:0.18em; text-transform:uppercase; color:#7A4F1E; margin-top:4px;">BY ASSETWIZE</div>
        </div>
      </div>
      <h1 class="text-aw-navy text-4xl md:text-5xl leading-tight mb-6 max-w-2xl" style="font-weight:500;">
        Asset governance, uitgewerkt tot een werkend systeem.
      </h1>
      <p class="text-lg leading-relaxed aw-prose mb-0"
         style="font-weight:400; color:var(--aw-slate);">
        Niet alleen wat assetmanagement zou moeten zijn. Maar hoe eigenaarschap, besluitvorming, informatie, processen en systemen daadwerkelijk samenkomen in de praktijk.
      </p>
    </div>
  </section>

  <!-- ② ANKERZIN -->
  <section class="bg-aw-wolk py-9">
    <div class="aw-container">
      <p class="aw-anker text-aw-navy text-base leading-relaxed max-w-2xl" style="--anker:var(--color-atlas); font-weight:500;">
        Waar ISO 55000 stopt, begint Atlas.
        <span style="font-weight:400; color:var(--aw-slate);">
          Een uitgewerkt governance-systeem met frameworks, blueprints en implementatierichtlijnen — gebouwd vanuit vijftien jaar praktijk in asset-intensieve organisaties.
        </span>
      </p>
    </div>
  </section>

  <!-- ③ WAAROM ATLAS BESTAAT -->
  <section class="bg-white py-20">
    <div class="aw-container">
      <p class="text-xs uppercase tracking-[0.12em] mb-4" style="font-weight:600; color:#7A4F1E;">Waarom Atlas bestaat</p>
      <div class="aw-split">
        <div>
          <h2 class="text-2xl md:text-3xl leading-snug mb-6" style="font-weight:500; color:var(--aw-navy);">
            Veel organisaties starten telkens opnieuw.
          </h2>
          <p class="text-sm leading-relaxed mb-4" style="font-weight:400; color:var(--aw-slate);">
            Rollen worden opnieuw ontworpen. Besluitvorming wordt opnieuw ingericht. CMMS-structuren worden opnieuw bedacht. Governance wordt opnieuw gedefinieerd.
          </p>
          <p class="text-sm leading-relaxed" style="font-weight:400; color:var(--aw-slate);">
            Niet omdat kennis ontbreekt. Maar omdat die kennis verspreid zit over normen, projecten, leveranciers en individuele ervaring. Atlas brengt die kennis samen in één samenhangend systeem.
          </p>
        </div>
        <div class="flex flex-col gap-4">
          {[
            { kop: "Bestuurlijke implementatie", sub: "Hoe governance daadwerkelijk landt op directieniveau." },
            { kop: "Procesmatige inrichting",   sub: "Hoe werkprocessen aansluiten op governance-principes." },
            { kop: "Operationele verankering",  sub: "Hoe uitvoering structureel wordt gekoppeld aan strategie." },
          ].map((item) => (
            <div style="border-left:3px solid var(--color-atlas); padding-left:16px;">
              <p class="text-sm mb-1" style="font-weight:500; color:var(--aw-navy);">{item.kop}</p>
              <p class="text-sm"     style="font-weight:400; color:var(--aw-slate);">{item.sub}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ④ ATLAS ALS REFERENTIEARCHITECTUUR -->
  <section class="bg-aw-mist py-20">
    <div class="aw-container">
      <p class="text-xs uppercase tracking-[0.12em] mb-4" style="font-weight:600; color:var(--aw-navy);">Atlas als referentiearchitectuur</p>
      <h2 class="text-2xl md:text-3xl leading-snug mb-6 max-w-lg" style="font-weight:500; color:var(--aw-navy);">
        Atlas beschrijft hoe alle onderdelen samenhangen.
      </h2>
      <p class="text-sm leading-relaxed mb-10 aw-prose" style="font-weight:400; color:var(--aw-slate);">
        Niet één proces. Maar hoe governance, risico, betrouwbaarheid, waarde, besluitvorming, organisatie en verandervermogen als één geïntegreerd systeem functioneren.
      </p>

      <!-- Zeven domeinen — globe -->
      <div class="datavlak datavlak--atlas mb-12">
        <div class="datavlak__kop datavlak__kop--smal"></div>
        <div class="hidden md:block bg-aw-wolk p-8">
        <svg width="100%" viewBox="0 0 680 560"
             style="max-width:680px; display:block; margin:0 auto;"
             xmlns="http://www.w3.org/2000/svg"
             role="img" aria-label="Atlas — zeven thema's op de meridiaanbol">
          <title>Atlas — zeven thema's</title>
          <circle cx="340" cy="280" r="162" fill="#FFFFFF" stroke="#B07D3A" stroke-width="0.8" opacity="0.25"/>
          <circle cx="340" cy="280" r="162" fill="none" stroke="#B07D3A" stroke-width="0.5" opacity="0.2"/>
          <line x1="340" y1="118" x2="340" y2="442" stroke="#B07D3A" stroke-width="0.7" opacity="0.18"/>
          <ellipse cx="340" cy="280" rx="81" ry="162" fill="none" stroke="#B07D3A" stroke-width="0.6" opacity="0.14"/>
          <ellipse cx="340" cy="280" rx="135" ry="162" fill="none" stroke="#B07D3A" stroke-width="0.4" opacity="0.09"/>
          <ellipse cx="340" cy="280" rx="162" ry="40" fill="none" stroke="#B07D3A" stroke-width="0.6" opacity="0.14"/>
          <ellipse cx="340" cy="226" rx="152" ry="27" fill="none" stroke="#B07D3A" stroke-width="0.4" opacity="0.08"/>
          <ellipse cx="340" cy="348" rx="144" ry="23" fill="none" stroke="#B07D3A" stroke-width="0.4" opacity="0.08"/>
          <path d="M340,140 Q300,195 232,208" fill="none" stroke="#7A4F1E" stroke-width="0.9" opacity="0.35"/>
          <path d="M340,140 Q380,195 448,208" fill="none" stroke="#7A4F1E" stroke-width="0.9" opacity="0.35"/>
          <path d="M232,208 Q216,262 198,308" fill="none" stroke="#7A4F1E" stroke-width="0.9" opacity="0.35"/>
          <path d="M448,208 Q464,262 482,308" fill="none" stroke="#7A4F1E" stroke-width="0.9" opacity="0.35"/>
          <path d="M198,308 Q222,370 256,392" fill="none" stroke="#7A4F1E" stroke-width="0.9" opacity="0.35"/>
          <path d="M482,308 Q458,370 424,392" fill="none" stroke="#7A4F1E" stroke-width="0.9" opacity="0.35"/>
          <path d="M256,392 Q340,412 424,392" fill="none" stroke="#7A4F1E" stroke-width="0.9" opacity="0.35"/>
          <path d="M232,208 Q340,258 482,308" fill="none" stroke="#B07D3A" stroke-width="0.5" opacity="0.18"/>
          <path d="M448,208 Q340,258 198,308" fill="none" stroke="#B07D3A" stroke-width="0.5" opacity="0.18"/>
          <path d="M232,208 Q338,300 424,392" fill="none" stroke="#B07D3A" stroke-width="0.4" opacity="0.12"/>
          <path d="M448,208 Q342,300 256,392" fill="none" stroke="#B07D3A" stroke-width="0.4" opacity="0.12"/>
          {domeinen.map((d) => (
            <g>
              <circle cx={d.cx} cy={d.cy} r="22" fill="#7A4F1E"/>
              <text x={d.cx} y={d.cy + 6} text-anchor="middle" font-family="Inter,sans-serif" font-size="12" font-weight="500" fill="#FFFFFF">{d.code}</text>
              <text x={d.lx} y={d.ly} text-anchor={d.anker} font-family="Inter,sans-serif" font-size="12" font-weight="500" fill="#7A4F1E" letter-spacing="0.08em">{d.code}</text>
              {d.regels.map((r, i) => (
                <text x={d.lx} y={d.ly + 15 * (i + 1)} text-anchor={d.anker} font-family="Inter,sans-serif" font-size="13" font-weight="500" fill="#1F2937">{r}</text>
              ))}
            </g>
          ))}
        </svg>
        </div>
        <!-- Onder 768 px: dezelfde domeinen als lijst -->
        <ul class="md:hidden divide-y divide-aw-mist">
          {[...domeinen].sort((x, y) => x.code.localeCompare(y.code)).map((d) => (
            <li class="flex items-start gap-4 px-5 py-3">
              <span class="flex-shrink-0 w-9 h-9 rounded-full flex items-center justify-center text-xs text-white" style="background:var(--color-atlas); font-weight:500;">{d.code}</span>
              <span class="text-sm text-aw-ink pt-2" style="font-weight:500;">{d.regels.join(' ')}</span>
            </li>
          ))}
        </ul>
      </div>

      <!-- Wat Atlas bevat -->
      <p class="text-xs uppercase tracking-[0.12em] mb-5" style="font-weight:600; color:var(--aw-navy);">Wat Atlas bevat</p>
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-x-12 gap-y-2">
        {[
          "Governance Frameworks",
          "Asset Management Operating Models",
          "Asset Investment Standards",
          "RACI-modellen",
          "Lifecycle Frameworks",
          "Data Governance Standards",
          "CMMS Blueprint Architectures",
          "Maintenance Governance Models",
          "Maturity Assessments",
          "ISO 55001 Reference Mappings",
          "Decision-Making Frameworks",
          "Implementation Guidelines",
        ].map((item) => (
          <div class="flex items-center gap-2 py-1.5" style="border-bottom:1px solid var(--aw-line);">
            <span style="color:var(--color-atlas); font-size:12px;">→</span>
            <span class="text-sm" style="font-weight:400; color:var(--aw-navy);">{item}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ⑤ OMVANG -->
  <section class="bg-white py-12">
    <div class="aw-container">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-px bg-aw-line border border-aw-line rounded-aw overflow-hidden">
        {[
          { getal: "7",    label: "samenhangende domeinen" },
          { getal: "50+",  label: "governance frameworks" },
          { getal: "100+", label: "blueprints en standaarden" },
          { getal: "15+",  label: "jaar praktijkervaring" },
        ].map((item) => (
          <div class="px-6 py-6 text-center" style="background:white;">
            <p style="font-size:28px; font-weight:500; color:#7A4F1E; line-height:1;">{item.getal}</p>
            <p style="font-size:12px; font-weight:400; color:var(--aw-slate); margin-top:6px; line-height:1.4;">{item.label}</p>
          </div>
        ))}
      </div>
      <p class="text-center mt-4 text-xs" style="color:var(--aw-slate);">
        Doorlopend verrijkt vanuit praktijkprojecten binnen industrie, utilities en agrochemie.
      </p>
    </div>
  </section>

  <!-- ⑥ EEN KIJKJE IN ATLAS -->
  <section class="bg-aw-wolk py-20">
    <div class="aw-container">
      <p class="text-xs uppercase tracking-[0.12em] mb-4" style="font-weight:600; color:var(--aw-navy);">Een kijkje in Atlas</p>
      <h2 class="text-2xl leading-snug mb-4" style="font-weight:500; color:var(--aw-navy);">
        Uitgewerkte bouwstenen, direct toepasbaar.
      </h2>
      <p class="text-sm leading-relaxed mb-12 aw-prose" style="font-weight:400; color:var(--aw-slate);">
        Elk document in Atlas is volledig uitgewerkt — met normatieve grondslag, rolbeschrijvingen, RACI-structuren, competentie-eisen en maturity levels. Hieronder een fragment uit T5.1 — het Asset Management Organisation Model.
      </p>

      <!-- VOORBEELD 1: Rollenstructuur -->
      <div class="datavlak datavlak--atlas mb-8">
        <div class="datavlak__kop flex items-center justify-between gap-4">
          <div>
            <p class="datavlak__label">T5.1 Blueprint · Governance &amp; Eigenaarschap</p>
            <p class="text-sm mt-1" style="color:white; font-weight:500;">Asset Management Organisation Model — Rollenstructuur</p>
          </div>
          <span class="text-xs px-2 py-1 rounded flex-shrink-0" style="background:rgba(255,255,255,0.15); color:rgba(255,255,255,0.8); font-weight:400;">ISO 55001 §5.3</span>
        </div>
        <div style="background:white; overflow-x:auto;">
          <table style="width:100%; border-collapse:collapse; font-size:12px;">
            <thead>
              <tr>
                <th style="padding:10px 14px; text-align:left; font-weight:600; color:#7A4F1E; border-bottom:1px solid var(--aw-line); font-size:12px; text-transform:uppercase; letter-spacing:0.12em;">Laag</th>
                <th style="padding:10px 14px; text-align:left; font-weight:600; color:#7A4F1E; border-bottom:1px solid var(--aw-line); font-size:12px; text-transform:uppercase; letter-spacing:0.12em;">Rollen</th>
                <th style="padding:10px 14px; text-align:left; font-weight:600; color:#7A4F1E; border-bottom:1px solid var(--aw-line); font-size:12px; text-transform:uppercase; letter-spacing:0.12em;">Uitbesteding</th>
              </tr>
            </thead>
            <tbody>
              {[
                { laag: "Eigendomsrollen", rollen: "Asset Owner · Asset Manager · Portfolio Manager", uitbesteding: "Aanbevolen: altijd eigen organisatie" },
                { laag: "Uitvoeringsrollen", rollen: "Maintenance Engineer · Contractor Manager · Werkvoorbereider · Planner · Teamlead · Technician", uitbesteding: "Engineer + Contractor Manager: eigen organisatie · Overige: beschikbaar voor uitbesteding" },
                { laag: "Stakeholderrollen", rollen: "Finance · SHE · Quality/Food Safety · Data Owner · Operations", uitbesteding: "Co-verantwoordelijken — geen klanten van assetmanagement" },
              ].map((row, i) => (
                <tr>
                  <td style="padding:10px 14px; color:var(--aw-ink); font-weight:500; border-bottom:1px solid var(--aw-mist); vertical-align:top; white-space:nowrap;">{row.laag}</td>
                  <td style="padding:10px 14px; color:var(--aw-ink); border-bottom:1px solid var(--aw-mist); vertical-align:top; line-height:1.6;">{row.rollen}</td>
                  <td style="padding:10px 14px; color:var(--aw-slate); border-bottom:1px solid var(--aw-mist); vertical-align:top; line-height:1.6;">{row.uitbesteding}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>

      <!-- VOORBEELD 2: RACI-fragment -->
      <div class="datavlak datavlak--atlas mb-8">
        <div class="datavlak__kop flex items-center justify-between gap-4">
          <div>
            <p class="datavlak__label">T5.1 Blueprint · RACI-matrix</p>
            <p class="text-sm mt-1" style="color:white; font-weight:500;">Verantwoordelijkheidsverdeling AM-processen (fragment)</p>
          </div>
          <span class="text-xs px-2 py-1 rounded flex-shrink-0" style="background:rgba(255,255,255,0.15); color:rgba(255,255,255,0.8); font-weight:400;">A · R · C · I</span>
        </div>
        <div style="background:white; overflow-x:auto;">
          <table style="width:100%; border-collapse:collapse; font-size:12px;">
            <thead>
              <tr>
                <th style="padding:8px 12px; text-align:left; font-weight:600; color:#7A4F1E; border-bottom:1px solid var(--aw-line); font-size:12px; text-transform:uppercase; letter-spacing:0.12em; min-width:180px;">AM-proces</th>
                {["Asset Owner","Asset Manager","Maint. Engineer","Contractor Mgr","Planner","Teamlead"].map(h => (
                  <th style="padding:8px 8px; text-align:center; font-weight:600; color:#7A4F1E; border-bottom:1px solid var(--aw-line); font-size:12px; text-transform:uppercase; letter-spacing:0.12em; min-width:72px;">{h}</th>
                ))}
              </tr>
            </thead>
            <tbody>
              {[
                { proc: "Kriticiteitsbepaling A/B/C", vals: ["C","A","R","—","—","—"] },
                { proc: "Onderhoudsstrategie bepalen", vals: ["C","A","R","—","—","—"] },
                { proc: "Investeringsvoorstel opstellen", vals: ["C","A","R","—","—","—"] },
                { proc: "Investeringsbesluit",           vals: ["A","R","C","—","—","—"] },
                { proc: "Planning & scheduling",         vals: ["—","I","C","—","A/R","C"] },
                { proc: "Contractormanagement",          vals: ["I","A","—","R","—","—"] },
                { proc: "Datakwaliteit systeem",         vals: ["I","A","C","C","—","—"] },
              ].map((row, i) => (
                <tr>
                  <td style="padding:8px 12px; color:var(--aw-ink); font-weight:400; border-bottom:1px solid var(--aw-mist);">{row.proc}</td>
                  {row.vals.map(v => (
                    <td style={`padding:8px 8px; text-align:center; border-bottom:1px solid var(--aw-mist); font-weight:500; font-size:12px; color:${v.includes("A") || v.includes("R") ? "var(--color-atlas)" : "var(--aw-slate)"};`}>{v}</td>
                  ))}
                </tr>
              ))}
            </tbody>
          </table>
          <p style="padding:8px 12px; font-size:12px; color:var(--aw-slate); border-top:1px solid var(--aw-mist);">
            A = Accountable · R = Responsible · C = Consulted · I = Informed · — = geen betrokkenheid
          </p>
        </div>
      </div>

      <!-- VOORBEELD 3: Maturity levels -->
      <div class="datavlak datavlak--atlas">
        <div class="datavlak__kop">
          <p class="datavlak__label">T5.1 Blueprint · Maturity Model</p>
          <p class="text-sm mt-1" style="color:white; font-weight:500;">Maturity Levels — Rolbezetting &amp; Eigenaarschap</p>
        </div>
        <div style="background:white;">
          {[
            { nr: "1", titel: "Ongeorganiseerd", tekst: "Rollen en verantwoordelijkheden zijn niet formeel vastgelegd. Assetmanagement is persoonsafhankelijk." },
            { nr: "2", titel: "Reactief", tekst: "Functionarissen aangewezen zonder formele functiebeschrijving. Serviceprovider neemt feitelijk beslissingen die de eigen organisatie zou moeten nemen." },
            { nr: "3", titel: "Gepland", tekst: "Functies beschreven met verantwoordelijkheden en bevoegdheden. RACI aanwezig voor kernprocessen. Competentie-eisen globaal vastgesteld." },
            { nr: "4", titel: "Proactief", tekst: "Functies actief ingevuld conform AM Operating Model. Competentie getoetst bij aanstelling. RACI is sturingsinstrument." },
            { nr: "5", titel: "Optimaliserend", tekst: "Rollenstructuur continu geëvalueerd. Eigenaarschap zichtbaar in gedrag — niet alleen op papier." },
          ].map((level, i) => (
            <div class="flex items-start gap-4 px-6 py-4" style={`border-bottom:${i < 4 ? "1px solid var(--aw-mist)" : "none"};`}>
              <span style={`min-width:24px; height:24px; border-radius:50%; display:flex; align-items:center; justify-content:center; font-size:12px; font-weight:500; flex-shrink:0; margin-top:1px; background:${i < 2 ? "var(--aw-wolk)" : i < 3 ? "color-mix(in srgb, var(--color-atlas) 10%, white)" : i < 4 ? "color-mix(in srgb, var(--color-atlas) 20%, white)" : "var(--color-atlas)"}; color:${i < 4 ? "#7A4F1E" : "white"};`}>{level.nr}</span>
              <div>
                <p style="font-size:14px; font-weight:500; color:var(--aw-ink); margin-bottom:2px;">{level.titel}</p>
                <p style="font-size:14px; color:var(--aw-slate); line-height:1.5;">{level.tekst}</p>
              </div>
            </div>
          ))}
        </div>
      </div>

      <p class="mt-6 text-xs" style="color:var(--aw-slate); font-weight:400;">
        Dit is één document uit T5 — Governance &amp; Eigenaarschap. Atlas bevat vergelijkbare uitwerkingen voor alle zeven domeinen.
      </p>
    </div>
  </section>

  <!-- ⑦ RELATIE MET COMPASS EN Relicore -->
  <section class="bg-white py-20">
    <div class="aw-container aw-split">
      <div>
      <p class="text-xs uppercase tracking-[0.12em] mb-4" style="font-weight:600; color:#7A4F1E;">De relatie met Compass en Relicore</p>
      <h2 class="text-2xl leading-snug mb-10 max-w-lg" style="font-weight:500; color:var(--aw-navy);">
        Compass meet. Relicore implementeert.<br />Atlas is het systeem waar beide op gebaseerd zijn.
      </h2>
      </div>
      <div class="flex flex-col divide-y divide-aw-line">
        {[
          { instrument:"Compass",            kleur:"var(--color-compass)", sub:"Diagnosticeert of het governance-systeem werkt — toetst aan de normen die Atlas beschrijft." },
          { instrument:"AssetWize expertise",kleur:"var(--aw-navy)", sub:"Ontwerpt het besturingssysteem — gebruikt Atlas-frameworks als normatieve basis voor elk ontwerp." },
          { instrument:"Relicore",           kleur:"var(--aw-turquoise)", sub:"Borgt de assetlogica digitaal — implementeert de informatiemodellen en blueprints die Atlas beschrijft." },
        ].map((item) => (
          <div class="flex flex-col sm:flex-row items-start gap-2 sm:gap-6 py-6">
            <span class="text-xs uppercase tracking-[0.12em] min-w-36 mt-0.5 flex-shrink-0"
                  style={`font-weight:600; color:${item.kleur};`}>{item.instrument}</span>
            <p class="text-sm leading-relaxed" style="font-weight:400; color:var(--aw-slate);">{item.sub}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ⑧ CTA -->
  <section class="bg-aw-deep py-20 text-center">
    <div class="aw-container">
      <h2 class="text-2xl md:text-3xl leading-snug mb-4 max-w-lg mx-auto"
          style="font-weight:500; color:white;">
        Wilt u weten hoe Atlas uw traject ondersteunt?
      </h2>
      <p class="text-base leading-relaxed mb-10 max-w-md mx-auto"
         style="font-weight:400; color:rgba(255,255,255,0.72);">
        In een eerste gesprek kijken we naar uw specifieke situatie — en welke frameworks en blueprints direct toepasbaar zijn.
      </p>
      <a href="/contact"
         class="aw-btn-primary inline-flex px-10 py-4">
        Start het gesprek
      </a>
    </div>
  </section>

</BaseLayout>
