---
import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../styles/global.css';
---
<BaseLayout
  title="Contact"
  description="Start het gesprek met AssetWize — over grip op risico, prestaties, investeringen en continuïteit van uw assets."
>

  <!-- HERO -->
  <section class="bg-navy-900 text-white pt-28 pb-20 px-6">
    <div class="max-w-4xl mx-auto">
      <p class="text-teal-400 text-xs uppercase tracking-widest mb-5"
         style="font-weight:600; letter-spacing:0.14em;">Contact</p>
      <h1 class="text-4xl md:text-5xl leading-tight mb-6 max-w-xl" style="font-weight:500;">
        Start het gesprek.
      </h1>
      <p class="text-white/60 text-lg leading-relaxed max-w-lg" style="font-weight:400;">
        In een eerste gesprek kijken we naar uw specifieke situatie — zonder verplichtingen, zonder verkooppitch. Alleen de vraag of en hoe AssetWize relevant is.
      </p>
    </div>
  </section>

  <!-- CONTACT INHOUD -->
  <section class="bg-white py-20 px-6">
    <div class="max-w-4xl mx-auto">
      <div class="grid md:grid-cols-2 gap-16 items-start">

        <!-- Links: context -->
        <div>
          <!-- Wanneer contact opnemen -->
          <p class="text-teal-700 text-xs uppercase tracking-widest mb-4"
             style="font-weight:600;">Neem contact op als</p>
          <div class="flex flex-col gap-3 mb-10">
            {[
              "Investeringen moeilijk onderbouwd worden",
              "Het CMMS veel data bevat maar weinig inzicht oplevert",
              "Verbeterprogramma's onvoldoende blijvend resultaat geven",
              "Bestuur en techniek verschillende werkelijkheden ervaren",
              "Eigenaarschap over assets onvoldoende expliciet is",
              "U niet weet waar u moet beginnen",
            ].map((item) => (
              <div class="flex items-start gap-3">
                <span class="text-teal-700 mt-0.5 flex-shrink-0">✓</span>
                <span class="text-gray-600 text-sm" style="font-weight:400;">{item}</span>
              </div>
            ))}
          </div>

          <p class="text-teal-700 text-xs uppercase tracking-widest mb-4"
             style="font-weight:600;">Wat u kunt verwachten</p>
          <div class="flex flex-col divide-y divide-gray-100">
            {[
              {
                num: "01",
                h: "Een gesprek, geen pitch",
                p: "We beginnen met uw situatie — niet met onze producten. Wat speelt er? Waar zit de pijn? Wat heeft u al geprobeerd?",
              },
              {
                num: "02",
                h: "Eerlijk advies",
                p: "Als Compass of RELICORE niet de juiste stap is, zeggen we dat. We zoeken naar de interventie die het meeste oplevert — niet de grootste opdracht.",
              },
              {
                num: "03",
                h: "Concrete vervolgstap",
                p: "Als er een match is, formuleren we een concreet voorstel. Als er geen match is, weet u dat ook — en dat heeft waarde op zich.",
              },
            ].map((item) => (
              <div class="flex items-start gap-5 py-6">
                <span class="text-teal-700 text-xs uppercase tracking-widest flex-shrink-0 mt-0.5"
                      style="font-weight:600;">{item.num}</span>
                <div>
                  <p class="text-navy-900 text-sm mb-1" style="font-weight:500;">{item.h}</p>
                  <p class="text-gray-500 text-sm leading-relaxed" style="font-weight:400;">{item.p}</p>
                </div>
              </div>
            ))}
          </div>

          <!-- Typische vraagstukken -->
          <div class="mt-8 pt-8 border-t border-gray-100">
            <p class="text-gray-400 text-xs uppercase tracking-widest mb-4"
               style="font-weight:500;">Typische vraagstukken</p>
            <div class="flex flex-col gap-2">
              {[
                "Governance Framework ontwikkelen",
                "Asset Governance Assessment (Compass)",
                "Lifecycle Investment Standard opzetten",
                "CMMS Governance Blueprint opstellen",
                "Asset Information Architecture ontwerpen",
                "Organisatieontwikkeling rondom assetmanagement",
              ].map((item) => (
                <div class="flex items-center gap-3">
                  <span class="text-teal-700 text-xs flex-shrink-0">→</span>
                  <span class="text-gray-600 text-sm" style="font-weight:400;">{item}</span>
                </div>
              ))}
            </div>
          </div>
        </div>

        <!-- Rechts: contactmogelijkheden -->
        <div class="flex flex-col gap-5">

          <!-- E-mail -->
          <a href="mailto:info@assetwize.nl"
             class="group border border-gray-200 rounded-xl p-7 hover:border-teal-700
                    transition-colors flex items-start gap-5">
            <div class="w-10 h-10 rounded-lg bg-teal-50 flex items-center justify-center flex-shrink-0">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none"
                   stroke="#147878" stroke-width="1.5" stroke-linecap="round" aria-hidden="true">
                <rect x="2" y="4" width="20" height="16" rx="2"/>
                <path d="M2 7l10 7 10-7"/>
              </svg>
            </div>
            <div>
              <p class="text-navy-900 text-sm mb-1" style="font-weight:500;">E-mail</p>
              <p class="text-teal-700 text-sm group-hover:underline" style="font-weight:400;">
                info@assetwize.nl
              </p>
            </div>
          </a>

          <!-- LinkedIn -->
          <a href="https://nl.linkedin.com/in/dimitryvandort"
             target="_blank" rel="noopener noreferrer"
             class="group border border-gray-200 rounded-xl p-7 hover:border-teal-700
                    transition-colors flex items-start gap-5">
            <div class="w-10 h-10 rounded-lg bg-teal-50 flex items-center justify-center flex-shrink-0">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="#147878" aria-hidden="true">
                <path d="M16 8a6 6 0 016 6v7h-4v-7a2 2 0 00-2-2 2 2 0 00-2 2v7h-4v-7a6 6 0 016-6z"/>
                <rect x="2" y="9" width="4" height="12"/>
                <circle cx="4" cy="4" r="2"/>
              </svg>
            </div>
            <div>
              <p class="text-navy-900 text-sm mb-1" style="font-weight:500;">LinkedIn</p>
              <p class="text-teal-700 text-sm group-hover:underline" style="font-weight:400;">
                Dimitry van Dort
              </p>
              <p class="text-gray-400 text-xs mt-0.5" style="font-weight:400;">
                Oprichter AssetWize
              </p>
            </div>
          </a>

          <!-- Compass starten -->
          <div class="border border-gray-200 rounded-xl p-7"
               style="background:#F7F8F6;">
            <p class="text-xs uppercase tracking-widest mb-3"
               style="font-weight:600; color:#2D6A4F;">Direct starten met Compass?</p>
            <p class="text-gray-600 text-sm leading-relaxed mb-5" style="font-weight:400;">
              Als u al weet dat u een diagnose wil van de bestuurbaarheid van uw assetorganisatie, kunt u direct meer lezen over Compass.
            </p>
            <a href="/compass"
               class="inline-flex items-center gap-2 text-xs uppercase tracking-widest"
               style="font-weight:600; color:#2D6A4F;">
              Meer over Compass
              <svg viewBox="0 0 16 16" width="12" height="12" fill="none"
                   stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                <path d="M3 8h10M9 4l4 4-4 4"/>
              </svg>
            </a>
          </div>

          <!-- Dimitry -->
          <div class="border border-gray-200 rounded-xl p-7">
            <p class="text-gray-400 text-xs uppercase tracking-widest mb-4"
               style="font-weight:500;">Direct contact</p>
            <p class="text-navy-900 text-sm mb-1" style="font-weight:500;">Dimitry van Dort</p>
            <p class="text-gray-500 text-sm mb-4" style="font-weight:400;">
              Oprichter AssetWize · Asset governance specialist
            </p>
            <p class="text-gray-400 text-xs leading-relaxed" style="font-weight:400;">
              Industrie · Utilities · Agrochemie · Gebouwbeheer · Voedingsmiddelen
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

</BaseLayout>
