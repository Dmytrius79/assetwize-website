---
import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../styles/global.css';
---
<BaseLayout
  title="Contact"
  description="Start het gesprek met AssetWize — over grip op risico, prestaties, investeringen en continuïteit van uw assets."
>

  <!-- HERO -->
  <section class="bg-white border-b border-aw-line pt-28 pb-20">
    <div class="aw-container">
      <p class="text-aw-turquoise text-xs uppercase tracking-[0.12em] mb-5"
         style="font-weight:600;">Contact</p>
      <h1 class="text-aw-navy text-4xl md:text-5xl leading-tight mb-6 max-w-xl" style="font-weight:500;">
        Start het gesprek.
      </h1>
      <p class="text-aw-slate text-lg leading-relaxed aw-prose" style="font-weight:400;">
        In een eerste gesprek kijken we naar uw specifieke situatie — zonder verplichtingen, zonder verkooppitch. Alleen de vraag of en hoe AssetWize relevant is.
      </p>
    </div>
  </section>

  <!-- CONTACT INHOUD -->
  <section class="bg-white py-20">
    <div class="aw-container">
      <div class="aw-split">

        <!-- Links: context -->
        <div>
          <!-- Wanneer contact opnemen -->
          <p class="text-aw-turquoise text-xs uppercase tracking-[0.12em] mb-4"
             style="font-weight:600;">Neem contact op als</p>
          <div class="flex flex-col gap-3 mb-10">
            {[
              "Investeringen moeilijk onderbouwd worden",
              "Het CMMS veel data bevat maar weinig inzicht oplevert",
              "Verbeterprogramma's onvoldoende blijvend resultaat geven",
              "Bestuur en techniek verschillende werkelijkheden ervaren",
              "Eigenaarschap over assets onvoldoende expliciet is",
              "U niet weet waar u moet beginnen",
            ].map((item) => (
              <div class="flex items-start gap-3">
                <span class="text-aw-turquoise mt-0.5 flex-shrink-0">✓</span>
                <span class="text-aw-ink text-sm" style="font-weight:400;">{item}</span>
              </div>
            ))}
          </div>

          <p class="text-aw-turquoise text-xs uppercase tracking-[0.12em] mb-4"
             style="font-weight:600;">Wat u kunt verwachten</p>
          <div class="flex flex-col divide-y divide-aw-line">
            {[
              {
                num: "01",
                h: "Een gesprek, geen pitch",
                p: "We beginnen met uw situatie — niet met onze producten. Wat speelt er? Waar zit de pijn? Wat heeft u al geprobeerd?",
              },
              {
                num: "02",
                h: "Eerlijk advies",
                p: "Als Compass of Relicore niet de juiste stap is, zeggen we dat. We zoeken naar de interventie die het meeste oplevert — niet de grootste opdracht.",
              },
              {
                num: "03",
                h: "Concrete vervolgstap",
                p: "Als er een match is, formuleren we een concreet voorstel. Als er geen match is, weet u dat ook — en dat heeft waarde op zich.",
              },
            ].map((item) => (
              <div class="flex items-start gap-5 py-6">
                <span class="text-aw-turquoise text-xs uppercase tracking-[0.12em] flex-shrink-0 mt-0.5"
                      style="font-weight:600;">{item.num}</span>
                <div>
                  <p class="text-aw-navy text-sm mb-1" style="font-weight:500;">{item.h}</p>
                  <p class="text-aw-slate text-sm leading-relaxed" style="font-weight:400;">{item.p}</p>
                </div>
              </div>
            ))}
          </div>

          <!-- Typische eerste stap -->
          <div class="mt-8 pt-8 border-t border-aw-line">
            <p class="text-aw-slate text-xs uppercase tracking-[0.12em] mb-4"
               style="font-weight:500;">Typische eerste stap</p>
            <div class="flex flex-col gap-3">
              {[
                { stap: "Compass",  sub: "Diagnose — waar ontbreekt grip en waarom?",          kleur: "var(--color-compass)", href: "/compass" },
                { stap: "Atlas",    sub: "Governance ontwerp — hoe zou het systeem moeten werken?", kleur: "#7A4F1E", href: "/atlas" },
                { stap: "Relicore", sub: "Informatie & structuur — hoe wordt governance geborgd?",  kleur: "var(--aw-turquoise)", href: "/relicore" },
              ].map((item) => (
                <a href={item.href}
                   class="flex items-start gap-3 py-2.5 hover:opacity-80 transition-opacity">
                  <span class="text-xs uppercase tracking-[0.12em] min-w-20 mt-0.5 flex-shrink-0"
                        style={`font-weight:600; color:${item.kleur};`}>{item.stap}</span>
                  <span class="text-aw-slate text-sm" style="font-weight:400;">{item.sub}</span>
                </a>
              ))}
            </div>
          </div>
        </div>

        <!-- Rechts: contactmogelijkheden -->
        <div class="flex flex-col gap-5">

          <!-- E-mail -->
          <a href="mailto:info@assetwize.nl"
             class="group border border-aw-line rounded-aw p-7 hover:border-aw-turquoise
                    transition-colors flex items-start gap-5">
            <div class="w-10 h-10 rounded-aw bg-aw-mist flex items-center justify-center flex-shrink-0">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none"
                   stroke="var(--aw-turquoise)" stroke-width="1.5" stroke-linecap="round" aria-hidden="true">
                <rect x="2" y="4" width="20" height="16" rx="2"/>
                <path d="M2 7l10 7 10-7"/>
              </svg>
            </div>
            <div>
              <p class="text-aw-navy text-sm mb-1" style="font-weight:500;">E-mail</p>
              <p class="text-aw-turquoise text-sm group-hover:underline" style="font-weight:400;">
                info@assetwize.nl
              </p>
            </div>
          </a>

          <!-- LinkedIn -->
          <a href="https://nl.linkedin.com/in/dimitryvandort"
             target="_blank" rel="noopener noreferrer"
             class="group border border-aw-line rounded-aw p-7 hover:border-aw-turquoise
                    transition-colors flex items-start gap-5">
            <div class="w-10 h-10 rounded-aw bg-aw-mist flex items-center justify-center flex-shrink-0">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="var(--aw-turquoise)" aria-hidden="true">
                <path d="M16 8a6 6 0 016 6v7h-4v-7a2 2 0 00-2-2 2 2 0 00-2 2v7h-4v-7a6 6 0 016-6z"/>
                <rect x="2" y="9" width="4" height="12"/>
                <circle cx="4" cy="4" r="2"/>
              </svg>
            </div>
            <div>
              <p class="text-aw-navy text-sm mb-1" style="font-weight:500;">LinkedIn</p>
              <p class="text-aw-turquoise text-sm group-hover:underline" style="font-weight:400;">
                Dimitry van Dort
              </p>
              <p class="text-aw-slate text-xs mt-0.5" style="font-weight:400;">
                Oprichter AssetWize
              </p>
            </div>
          </a>

          <!-- Compass starten -->
          <div class="bg-aw-wolk border border-aw-line rounded-aw p-7">
            <p class="text-xs uppercase tracking-[0.12em] mb-3"
               style="font-weight:600; color:var(--color-compass);">Direct starten met Compass?</p>
            <p class="text-aw-ink text-sm leading-relaxed mb-5" style="font-weight:400;">
              Als u al weet dat u een diagnose wil van de bestuurbaarheid van uw assetorganisatie, kunt u direct meer lezen over Compass.
            </p>
            <a href="/compass"
               class="inline-flex items-center gap-2 text-xs uppercase tracking-[0.12em]"
               style="font-weight:600; color:var(--color-compass);">
              Meer over Compass
              <svg viewBox="0 0 16 16" width="12" height="12" fill="none"
                   stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                <path d="M3 8h10M9 4l4 4-4 4"/>
              </svg>
            </a>
          </div>

          <!-- Dimitry -->
          <div class="border border-aw-line rounded-aw p-7">
            <p class="text-aw-slate text-xs uppercase tracking-[0.12em] mb-4"
               style="font-weight:500;">Direct contact</p>
            <p class="text-aw-navy text-sm mb-1" style="font-weight:500;">Dimitry van Dort</p>
            <p class="text-aw-slate text-sm mb-4" style="font-weight:400;">
              Oprichter AssetWize · Asset governance specialist
            </p>
            <p class="text-aw-slate text-xs leading-relaxed" style="font-weight:400;">
              Industrie · Utilities · Agrochemie · Gebouwbeheer · Voedingsmiddelen
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

</BaseLayout>
