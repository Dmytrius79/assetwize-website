---
import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../styles/global.css';
import HeroScherm from '../../components/compass-voorbeeld/HeroScherm.astro';
import ScorePerThema from '../../components/compass-voorbeeld/ScorePerThema.astro';
import Spiegel from '../../components/compass-voorbeeld/Spiegel.astro';
import Diagnosekaart from '../../components/compass-voorbeeld/Diagnosekaart.astro';
import PerspectiefSymbool from '../../components/compass-voorbeeld/PerspectiefSymbool.astro';

const verschil = [
  { aanwezig: "onderhoudsprocessen en een CMMS", ontbreekt: "eigenaarschap voor assets" },
  { aanwezig: "KPI-rapportage", ontbreekt: "risico's waar daadwerkelijk op wordt gestuurd" },
  { aanwezig: "investeringsplannen", ontbreekt: "een afweging waarom juist deze prioriteit" },
  { aanwezig: "verbeterprogramma's", ontbreekt: "een gedeelde taal tussen directie en techniek" },
];

const perspectieven = [
  { soort: 'koers' as const, label: "Koers", titel: "Waar is meer grip nodig?", tekst: "Maakt zichtbaar hoe keuzes over bedrijfsmiddelen, risico's en investeringen worden onderbouwd en waar samenhang ontbreekt." },
  { soort: 'controle' as const, label: "Controle", titel: "Wat werkt goed en waar loopt het vast?", tekst: "Onderzoekt hoe verantwoordelijkheden, informatie en processen in de praktijk functioneren, samen met management en proceseigenaren." },
  { soort: 'groei' as const, label: "Groei", badge: "Binnenkort" },
];

const werkwijze = [
  "Elke vraag krijgt een antwoord. Is er onvoldoende zicht op een onderwerp, dan is dat zelf een bevinding: we onderzoeken samen waar het aan ligt.",
  "Een consultant begeleidt de diagnose. Compass is geen zelftest: de uitkomst wordt samen besproken en onderbouwd.",
  "Compass staat los van onze andere instrumenten en kan concluderen dat software niet de eerste stap is.",
];
---
<BaseLayout
  title="Compass — begeleide diagnose van grip op assetmanagement"
  description="Compass is een begeleide diagnose van grip op assetmanagement voor asset-intensieve organisaties."
>

  <!-- ① HERO -->
  <section class="bg-forest-700 text-white pt-28 pb-20">
    <div class="aw-container">
      <div class="mb-10 pb-8 border-b border-white/15">
        <img src="/brand/producten/compass-donker.svg" alt="Compass" width="208" height="78" style="margin:-13px 0 -13px -13px;" />
      </div>
      <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-start">
        <div class="min-w-0">
          <p class="text-xs uppercase tracking-[0.12em] text-forest-200 mb-5" style="font-weight:600;">Compass · diagnose van assetmanagement</p>
          <h1 class="text-4xl md:text-5xl mb-6" style="font-weight:500; line-height:1.13;">
            Processen ingericht. Maar werkt het ook in de praktijk?
          </h1>
          <p class="text-white/65 text-lg leading-relaxed aw-prose mb-10" style="font-weight:400;">
            Compass maakt zichtbaar waar de samenhang ontbreekt tussen keuzes, verantwoordelijkheden en uitvoering rondom bedrijfsmiddelen. In begeleide gesprekken met directie en management onderzoeken we wat goed werkt, waar het vastloopt en welke besluiten nodig zijn.
          </p>
          <div class="flex flex-col sm:flex-row gap-4">
            <a href="/contact"
               class="inline-flex justify-center px-7 py-3.5 bg-white hover:bg-forest-100
                      text-forest-700 rounded-lg transition-colors text-sm"
               style="font-weight:500;">
              Plan een gesprek
            </a>
            <a href="https://compass.assetwize.nl" target="_blank" rel="noopener"
               class="inline-flex justify-center px-7 py-3.5 border border-white/60
                      hover:border-white text-white/80 hover:text-white
                      rounded-lg transition-colors text-sm"
               style="font-weight:500;">
              Bekijk Compass live
            </a>
          </div>
        </div>
        <div class="min-w-0">
          <HeroScherm />
        </div>
      </div>
    </div>
  </section>

  <!-- ② HERKENT U DIT? -->
  <section class="bg-white py-20">
    <div class="aw-container">
      <h2 class="text-2xl md:text-3xl leading-snug text-forest-900 mb-10" style="font-weight:500;">
        Herkent u dit?
      </h2>
      <table class="w-full max-w-3xl border-collapse text-sm sm:text-base">
        <thead>
          <tr class="border-b border-stone-300">
            <th scope="col" class="text-left py-3 pr-4 w-1/2 text-xs uppercase tracking-[0.12em] text-forest-400" style="font-weight:600;">Wat er ligt</th>
            <th scope="col" class="text-left py-3 pl-4 w-1/2 text-xs uppercase tracking-[0.12em] text-forest-600" style="font-weight:600;">Wat daarmee nog niet geregeld is</th>
          </tr>
        </thead>
        <tbody>
          {verschil.map((r) => (
            <tr class="border-b border-stone-200">
              <td class="py-4 pr-4 align-top text-forest-400" style="font-weight:400;">{r.aanwezig}</td>
              <td class="py-4 pl-4 align-top text-forest-900" style="font-weight:500;">{r.ontbreekt}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <!-- ③ DRIE PERSPECTIEVEN -->
  <section id="drie-perspectieven" class="bg-forest-50 py-20">
    <div class="aw-container">
      <h2 class="text-2xl md:text-3xl leading-snug text-forest-900 mb-10" style="font-weight:500;">
        Van overzicht naar inzicht
      </h2>
      <div class="grid md:grid-cols-3 gap-4">
        {perspectieven.map((p) => (
          <div class="bg-white rounded-lg flex items-start gap-4" style="border:1px solid #C9CED6; padding:20px 22px;">
            <div class="flex-shrink-0" style="margin-top:2px;"><PerspectiefSymbool soort={p.soort} /></div>
            <div class="min-w-0">
              <div class="flex items-center gap-2" style="margin-bottom:5px;">
                <p class="uppercase tracking-[0.12em]" style="font-size:11px; font-weight:600; color:#2D6A4F; margin:0;">{p.label}</p>
                {p.badge && (
                  <span style="font-size:10px; font-weight:500; letter-spacing:0.04em; color:#5B6B7F; border:1px solid #C9CED6; border-radius:3px; padding:0 6px; line-height:16px;">{p.badge}</span>
                )}
              </div>
              {p.titel && <p style="font-size:15px; font-weight:500; color:#1A2E22; margin:0 0 6px; line-height:1.3;">{p.titel}</p>}
              {p.tekst && <p style="font-size:14px; color:#5B6B7F; line-height:1.6; margin:0;">{p.tekst}</p>}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ④ DE UITKOMST -->
  <section class="bg-white py-20">
    <div class="aw-container">
      <h2 class="text-2xl md:text-3xl leading-snug text-forest-900 mb-10" style="font-weight:500;">
        Zo ziet de uitkomst eruit.
      </h2>

      <div class="flex flex-col gap-10">
        <ScorePerThema />
        <Spiegel />
      </div>

      <h3 class="text-xl md:text-2xl leading-snug text-forest-900 mt-16 mb-6" style="font-weight:500;">
        Controle: uittreksel van de diagnosekaart
      </h3>
      <Diagnosekaart />
    </div>
  </section>

  <!-- ⑤ ZO WERKT DE DIAGNOSE -->
  <section class="bg-forest-50 py-20">
    <div class="aw-container">
      <h2 class="text-2xl md:text-3xl leading-snug text-forest-900 mb-10" style="font-weight:500;">
        Zo werkt de diagnose.
      </h2>
      <ol class="grid md:grid-cols-3 gap-8" style="list-style:none; padding:0; margin:0;">
        {werkwijze.map((tekst, i) => (
          <li class="border-t-2 border-forest-600 pt-5">
            <p class="text-xs text-forest-600 mb-3" style="font-weight:500;">{i + 1}</p>
            <p class="text-forest-900 text-base leading-relaxed" style="font-weight:400;">{tekst}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ⑥ AFSLUITING -->
  <section class="bg-white py-20">
    <div class="aw-container text-center">
      <h2 class="text-2xl md:text-3xl leading-snug text-forest-900 mb-4" style="font-weight:500;">
        Wilt u weten waar uw organisatie staat?
      </h2>
      <p class="text-forest-400 text-base leading-relaxed mb-10 aw-prose mx-auto" style="font-weight:400;">
        Een eerste gesprek laat zien of Compass bij uw situatie past.
      </p>
      <a href="/contact"
         class="inline-flex px-10 py-4 bg-forest-700 hover:bg-forest-600
                text-white rounded-lg transition-colors text-base"
         style="font-weight:500;">
        Plan een gesprek
      </a>
    </div>
  </section>

</BaseLayout>
