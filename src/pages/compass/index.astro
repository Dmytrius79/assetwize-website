---
import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../styles/global.css';
import HeroScherm from '../../components/compass-voorbeeld/HeroScherm.astro';
import ScorePerThema from '../../components/compass-voorbeeld/ScorePerThema.astro';
import Spiegel from '../../components/compass-voorbeeld/Spiegel.astro';
import Diagnosekaart from '../../components/compass-voorbeeld/Diagnosekaart.astro';
import PerspectiefSymbool from '../../components/compass-voorbeeld/PerspectiefSymbool.astro';

// Tekst: TASK-014, letterlijk
const zesVragen = [
  "Is duidelijk wie eindverantwoordelijk is en ingrijpt als belangrijke prestaties of risico's tekortschieten?",
  "Kunt u onderbouwen welke risico's uw organisatie bewust accepteert, waarom, en wie daarover beslist?",
  "Kunt u aan een toezichthouder laten zien hoe belangrijke risicoafwegingen tot stand kwamen?",
  "Weet u welke aannames achter uw belangrijkste cijfers zitten, en hoe onzeker die zijn?",
  "Weet u welke bedrijfsmiddelen voldoende bijdragen aan uw doelen en welke achterblijven?",
  "Weegt u bij strategische plannen mee wat uw bedrijfsmiddelen mogelijk maken en beperken?",
];
---
<BaseLayout
  title="Compass — bestuurbaarheid in beeld"
  description="Compass maakt zichtbaar waar besluiten over bedrijfsmiddelen niet aansluiten op verantwoordelijkheid, informatie en uitvoering. Begeleide diagnose."
>

  <!-- ① HERO -->
  <section class="bg-forest-700 text-white pt-28 pb-20">
    <div class="aw-container">
      <div class="mb-10 pb-8 border-b border-white/15">
        <img src="/brand/producten/compass-donker.svg" alt="Compass" width="208" height="78" style="margin:-13px 0 -13px -13px;" />
      </div>
      <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-start">
        <div class="min-w-0">
          <p class="text-xs uppercase tracking-[0.12em] text-forest-200 mb-5" style="font-weight:600;">Compass · bestuurbaarheid in beeld</p>
          <h1 class="text-4xl md:text-5xl mb-6" style="font-weight:500; line-height:1.13;">
            Kunt u uw belangrijkste investeringen en risicoafwegingen onderbouwen?
          </h1>
          <p class="text-white/65 text-lg leading-relaxed aw-prose mb-4" style="font-weight:400;">
            Besluiten over bedrijfsmiddelen bepalen de prestaties, de risico's en de continuïteit van uw organisatie. Maar is duidelijk waarop die besluiten rusten, wie ervoor verantwoordelijk is en of de uitvoering erbij aansluit?
          </p>
          <p class="text-white/65 text-lg leading-relaxed aw-prose mb-10" style="font-weight:400;">
            Compass maakt zichtbaar waar informatie, verantwoordelijkheid en besluitvorming los van elkaar raken. In begeleide gesprekken met directie en management onderzoeken we wat werkt, waar de samenhang ontbreekt en welke keuzes nu aandacht verdienen.
          </p>
          <div class="flex flex-col sm:flex-row gap-4">
            <a href="/contact"
               class="inline-flex justify-center px-7 py-3.5 bg-white hover:bg-forest-100
                      text-forest-700 rounded-lg transition-colors text-sm"
               style="font-weight:500;">
              Plan een gesprek
            </a>
            <a href="https://compass.assetwize.nl" target="_blank" rel="noopener"
               class="inline-flex justify-center px-7 py-3.5 border border-white/60
                      hover:border-white text-white/80 hover:text-white
                      rounded-lg transition-colors text-sm"
               style="font-weight:500;">
              Bekijk Compass live
            </a>
          </div>
        </div>
        <div class="min-w-0">
          <HeroScherm />
        </div>
      </div>
    </div>
  </section>

  <!-- ② ZES VRAGEN -->
  <section class="bg-white py-20">
    <div class="aw-container">
      <h2 class="text-2xl md:text-3xl leading-snug text-forest-900 mb-10" style="font-weight:500;">
        Zes vragen waar u een antwoord op moet hebben
      </h2>
      <ol class="grid md:grid-cols-2 gap-x-10 gap-y-6" style="list-style:none; padding:0; margin:0;">
        {zesVragen.map((vraag, i) => (
          <li class="flex gap-4 border-t border-stone-300 pt-5">
            <span class="flex-shrink-0 w-7 h-7 rounded-full border border-forest-600 text-forest-600 text-xs inline-flex items-center justify-center" style="font-weight:500;">{i + 1}</span>
            <p class="text-forest-900 text-base leading-relaxed" style="font-weight:400;">{vraag}</p>
          </li>
        ))}
      </ol>
      <p class="text-forest-400 text-base leading-relaxed mt-10" style="font-weight:400; max-width:none;">
        Lukt het u om alle zes direct te beantwoorden, én aan te geven waarop dat antwoord rust? Dan staat u sterk. Zo niet, dan weet u waar u moet beginnen. Compass stelt vragen als deze. We bespreken waarop uw antwoorden zijn gebaseerd en toetsen ze aan concrete voorbeelden uit de organisatie.
      </p>
    </div>
  </section>

  <!-- ③ + ④ AANWEZIG ≠ WERKEND · KEURINGSBEWIJZEN ≠ GRIP -->
  <section class="bg-forest-50 py-20">
    <div class="aw-container grid md:grid-cols-2 gap-12 md:gap-16">
      <div>
        <h2 class="text-2xl md:text-3xl leading-snug text-forest-900 mb-5" style="font-weight:500;">
          Aanwezig is nog niet hetzelfde als werkend.
        </h2>
        <p class="text-forest-900 text-base leading-relaxed" style="font-weight:400;">
          Veel assessments tellen wat er is: procedures, systemen, rollen. Compass vraagt of het werkt: hoe besluiten worden genomen, wie ze draagt en of de organisatie ervan leert. Elk antwoord valt op een ladder van vijf stadia: <strong style="font-weight:500;">Reactief · Fragmentarisch · Ingericht · Geborgd · Lerend</strong>.
        </p>
      </div>
      <div>
        <h2 class="text-2xl md:text-3xl leading-snug text-forest-900 mb-5" style="font-weight:500;">
          Een map vol keuringsbewijzen is nog geen bewijs van grip.
        </h2>
        <p class="text-forest-900 text-base leading-relaxed" style="font-weight:400;">
          Bij een incident of een toezichthouder aan tafel telt niet of de documenten er zijn, maar of u kunt laten zien hoe risico's zijn afgewogen en wie besliste. Compass is geen juridische toets en geen certificering.
        </p>
      </div>
    </div>
  </section>

  <!-- ⑤ KOERS: zeven thema's, één eerlijk beeld -->
  <section id="drie-perspectieven" class="bg-white py-20">
    <div class="aw-container">
      <h2 class="text-2xl md:text-3xl leading-snug text-forest-900 mb-5" style="font-weight:500;">
        Van oordeel naar verklaring.
      </h2>
      <p class="text-forest-900 text-base leading-relaxed mb-3" style="font-weight:400; max-width:none;">
        Compass werkt in stappen. Elke stap beantwoordt een andere vraag en bouwt voort op de vorige.
      </p>
      <p class="mb-12 text-sm text-forest-600" style="font-weight:500;">Voorbeeld met de Voorbeeldorganisatie.</p>

      <div class="grid lg:grid-cols-5 gap-10 lg:gap-14 items-start">
        <div class="lg:col-span-2">
          <div class="flex items-center gap-3 mb-4">
            <PerspectiefSymbool soort="koers" />
            <p class="uppercase tracking-[0.12em]" style="font-size:11px; font-weight:600; color:#2D6A4F; margin:0;">1 · Koers</p>
          </div>
          <h3 class="text-xl md:text-2xl leading-snug text-forest-900 mb-4" style="font-weight:500;">Zeven thema's, één eerlijk beeld.</h3>
          <p class="text-forest-900 text-base leading-relaxed" style="font-weight:400;">
            Koers brengt de zeven thema's in beeld waarop een directie stuurt, van risico en investeringen tot governance en betrouwbaarheid. U ziet waar u op kunt bouwen en waar keuzes om betere onderbouwing vragen. Ook "dat weten we niet" telt: onvoldoende zicht is zelf een bevinding.
          </p>
        </div>
        <div class="lg:col-span-3"><ScorePerThema /></div>
      </div>
      <div class="mt-10"><Spiegel /></div>
    </div>
  </section>

  <!-- ⑥ CONTROLE: de werkprocessen erachter -->
  <section class="bg-forest-50 py-20">
    <div class="aw-container">
      <div class="grid lg:grid-cols-5 gap-10 lg:gap-14 items-start">
        <div class="lg:col-span-2">
          <div class="flex items-center gap-3 mb-4">
            <PerspectiefSymbool soort="controle" />
            <p class="uppercase tracking-[0.12em]" style="font-size:11px; font-weight:600; color:#2D6A4F; margin:0;">2 · Controle</p>
          </div>
          <h3 class="text-xl md:text-2xl leading-snug text-forest-900 mb-4" style="font-weight:500;">De werkprocessen erachter.</h3>
          <p class="text-forest-900 text-base leading-relaxed mb-4" style="font-weight:400;">
            Koers wijst aan waar u moet kijken, Controle gaat de diepte in. Per thema worden de onderliggende werkprocessen beoordeeld, in vier fasen: plannen, uitvoeren, controleren en bijsturen. Zo ziet u welke processen goed lopen, hoe goed de organisatie ervan leert en of ze zich kan aanpassen.
          </p>
          <p class="text-forest-900 text-base leading-relaxed" style="font-weight:400;">
            Controle werkt en wordt op dit moment volledig herzien.
          </p>
        </div>
        <div class="lg:col-span-3"><Diagnosekaart /></div>
      </div>
    </div>
  </section>

  <!-- ⑦ GROEI: nog leeg -->
  <section class="bg-white py-20">
    <div class="aw-container">
      <div class="grid lg:grid-cols-5 gap-10 lg:gap-14 items-start">
        <div class="lg:col-span-2">
          <div class="flex items-center gap-3 mb-4">
            <PerspectiefSymbool soort="groei" gedempt={true} />
            <p class="uppercase tracking-[0.12em]" style="font-size:11px; font-weight:600; color:#5B6B7F; margin:0;">3 · Groei</p>
          </div>
          <h3 class="text-xl md:text-2xl leading-snug text-forest-900 mb-4" style="font-weight:500;">Van verklaring naar ontwikkelpad.</h3>
          <p class="text-forest-900 text-base leading-relaxed" style="font-weight:400;">
            Op basis van wat Koers en Controle laten zien, stelt u samen een ontwikkelpad vast. Groei is in ontwikkeling.
          </p>
        </div>
        <div class="lg:col-span-3">
          <div class="flex items-center justify-center rounded-lg" style="border:1px dashed #C9CED6; background-color:#F7F8F7; min-height:200px;">
            <p class="uppercase tracking-[0.12em]" style="font-size:12px; font-weight:600; color:#5B6B7F; margin:0;">Binnenkort</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ⑧ AFSLUITING -->
  <section class="bg-forest-50 py-20">
    <div class="aw-container">
      <h2 class="text-2xl md:text-3xl leading-snug text-forest-900 mb-6" style="font-weight:500;">
        Een diagnose is geen doel. Het is het begin van meer grip.
      </h2>
      <p class="text-forest-900 text-base leading-relaxed" style="font-weight:400; max-width:none;">
        Compass laat zien waar het knelt: de eerste stap naar meer grip op uw bedrijfsmiddelen. Wij leveren geen software en geen methode, maar een oplossing: per verandering, met uw eigen mensen, en klaar zodra het zonder ons werkt.
      </p>

      <div class="mt-16 pt-16 border-t border-stone-300 text-center">
        <h2 class="text-2xl md:text-3xl leading-snug text-forest-900 mb-4" style="font-weight:500;">
          Welk besluit wilt u terugzien in de praktijk?
        </h2>
        <p class="text-forest-400 text-base leading-relaxed mb-10 aw-prose mx-auto" style="font-weight:400;">
          Neem het mee naar een eerste gesprek. Dan zien we samen of Compass bij uw situatie past.
        </p>
        <a href="/contact"
           class="inline-flex px-10 py-4 bg-forest-700 hover:bg-forest-600
                  text-white rounded-lg transition-colors text-base"
           style="font-weight:500;">
          Plan een gesprek
        </a>
      </div>
    </div>
  </section>

</BaseLayout>
