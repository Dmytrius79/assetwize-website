---
import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../styles/global.css';
---
<BaseLayout
  title="Relicore — lifecycle asset intelligence"
  description="Relicore is de engineeringlaag boven uw CMMS — die ruwe assetdata omzet in een herleidbare basis voor reliability, lifecycle en investeringsbeslissingen."
>

  <!-- ① HERO -->
  <section class="bg-white border-b border-aw-line pt-28 pb-20">
    <div class="aw-container">
      <div class="flex items-center gap-4 mb-10 pb-8 border-b border-aw-line">
        <svg viewBox="0 0 40 40" width="52" height="52" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <circle cx="20" cy="20" r="16" fill="none" stroke="var(--aw-turquoise)" stroke-width="1.5"/>
          <circle cx="20" cy="20" r="4"  fill="none" stroke="var(--aw-turquoise)" stroke-width="1.5"/>
          <line x1="20" y1="4"  x2="20" y2="16" stroke="var(--aw-turquoise)" stroke-width="1.5"/>
          <line x1="20" y1="24" x2="20" y2="36" stroke="var(--aw-turquoise)" stroke-width="1.5"/>
          <line x1="4"  y1="20" x2="16" y2="20" stroke="var(--aw-turquoise)" stroke-width="1.5"/>
          <line x1="24" y1="20" x2="36" y2="20" stroke="var(--aw-turquoise)" stroke-width="1.5"/>
        </svg>
        <div style="border-left:0.5px solid var(--aw-line); padding-left:12px;">
          <div style="font-size:26px; font-weight:500; color:var(--aw-navy); letter-spacing:0.05em; line-height:1.1;">Relicore</div>
          <div style="font-size:12px; font-weight:500; letter-spacing:0.18em; text-transform:uppercase; color:var(--aw-navy); line-height:1; margin-top:4px;">BY ASSETWIZE</div>
        </div>
      </div>
      <h1 class="text-aw-navy text-4xl md:text-5xl leading-tight mb-5 max-w-xl" style="font-weight:500;">
        Structuur in assets.<br />Grip op beslissingen.
      </h1>
      <p class="text-aw-slate text-lg leading-relaxed aw-prose mb-10" style="font-weight:400;">
        CMMS gevuld. Maar geen grip op structuur. Relicore maakt expliciet hoe assets bijdragen aan waarde, risico en continuïteit — zodat beslissingen niet op gevoel genomen worden.
      </p>
      <div class="flex flex-col sm:flex-row gap-4">
        <a href="https://relicore.app"
           target="_blank" rel="noopener noreferrer"
           class="aw-btn-primary inline-flex px-7 py-3.5 text-sm">
          Bekijk pilotomgeving
        </a>
        <a href="/contact"
           class="aw-btn-secondary inline-flex px-7 py-3.5 text-sm">
          Plan een gesprek
        </a>
      </div>
    </div>
  </section>

  <!-- ② ANKERZIN -->
  <section class="bg-white py-9">
    <div class="aw-container">
      <p class="aw-anker text-aw-navy text-base leading-relaxed max-w-2xl" style="--anker:var(--color-relicore); font-weight:500;">
        Relicore vervangt uw CMMS niet.
        <span class="text-aw-slate" style="font-weight:400;">
          Het maakt expliciet welke assets er zijn, wat ze doen, waaraan ze bijdragen — en op welke basis beslissingen over risico, waarde en continuïteit genomen kunnen worden.
        </span>
      </p>
    </div>
  </section>


  <!-- ③ HET PROBLEEM -->
  <section class="bg-aw-wolk py-20">
    <div class="aw-container aw-split">
      <div>
      <p class="text-aw-navy text-xs uppercase tracking-[0.12em] mb-4" style="font-weight:500;">Het probleem</p>
      <h2 class="text-2xl md:text-3xl leading-snug text-aw-navy mb-3 max-w-lg" style="font-weight:500;">
        CMMS gevuld. Maar geen grip op structuur.
      </h2>
      <p class="text-aw-slate text-sm mb-10 aw-prose" style="font-weight:400;">
        Asset-intensieve organisaties vullen hun CMMS jarenlang. Toch ontbreekt de basis voor beslissingen.
      </p>
      </div>
      <div class="divide-y divide-aw-line">
        {[
          {
            label: "Verkeerd perspectief",
            tekst: "Assets worden geregistreerd vanuit wat er staat — niet vanuit wat er moet werken. Het register groeit organisch. Resultaat: technisch gevuld, strategisch onbruikbaar.",
          },
          {
            label: "Beslissingen op gevoel",
            tekst: "Zonder gedeelde assetlogica worden vervangings- en investeringsbeslissingen niet onderbouwd. Elke afdeling redeneert vanuit eigen aannames. Consensus is toevallig.",
          },
          {
            label: "Risico niet herleidbaar",
            tekst: "Wettelijk verplichte keuringen, criticality en eigenaarschap zijn niet expliciet gekoppeld aan assets. Risico is aanwezig — maar niet bestuurbaar.",
          },
        ].map((item) => (
          <div class="flex flex-col sm:flex-row items-start gap-2 sm:gap-6 py-6">
            <span class="text-xs uppercase tracking-[0.12em] text-aw-navy min-w-36 mt-0.5 flex-shrink-0"
                  style="font-weight:500;">{item.label}</span>
            <p class="text-aw-slate text-sm leading-relaxed" style="font-weight:400;">{item.tekst}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ④ HOE Relicore WERKT -->
  <section class="bg-white py-20">
    <div class="aw-container aw-split">
      <div>
      <p class="text-aw-turquoise text-xs uppercase tracking-[0.12em] mb-4" style="font-weight:500;">Hoe Relicore werkt</p>
      <h2 class="text-2xl md:text-3xl leading-snug text-aw-navy mb-3" style="font-weight:500;">
        Van brondata naar geborgde assetstructuur.
      </h2>
      <p class="text-aw-slate text-sm mb-10 aw-prose" style="font-weight:400;">
        Zes stappen — gebaseerd op de werkelijke applicatiestructuur.
      </p>
      </div>
      <div class="relative">
        <!-- Verticale lijn -->
        <div class="absolute left-5 top-6 bottom-6 w-px bg-aw-line"></div>
        {[
          { num: "CMMS", label: "Brondata",           sub: "Ultimo · SAP · andere systemen",                         live: false },
          { num: "01",   label: "Importeren",          sub: "Procesfunctiestructuur · Equipment · Stamdata",          live: true  },
          { num: "02",   label: "Stamdata",            sub: "Assetsoorten · Naamgeving · Ruimtes · Gebouwen",         live: true  },
          { num: "03",   label: "Assetregister",       sub: "Procesboom bouwen · Equipment koppelen · Verifiëren",    live: true  },
          { num: "04",   label: "Data Kwaliteit",      sub: "Completeness-score · FK-status · lifecycle-koppeling",  live: true  },
          { num: "05",   label: "Exporteren & Borgen", sub: "Terug naar CMMS · structuur actueel houden",            live: true  },
        ].map((stap) => (
          <div class="flex items-start gap-5 py-4 relative">
            <div class={`w-10 h-10 rounded-full flex-shrink-0 flex items-center justify-center z-10
                        text-xs tracking-wide
                        ${stap.live ? 'bg-aw-navy text-aw-turquoise-light' : 'bg-aw-line text-aw-slate'}`}
                 style="font-weight:500; letter-spacing:0.05em;">
              {stap.num}
            </div>
            <div class="pt-2">
              <p class="text-aw-navy text-sm mb-1" style="font-weight:500;">{stap.label}</p>
              <p class="text-aw-slate text-xs" style="font-weight:400;">{stap.sub}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>


  <!-- ⑤ APP SCHERMEN -->
  <section class="bg-aw-wolk py-20">
    <div class="aw-container">
      <p class="text-aw-navy text-xs uppercase tracking-[0.12em] mb-4" style="font-weight:500;">Wat u ziet in de applicatie</p>
      <h2 class="text-2xl md:text-3xl leading-snug text-aw-navy mb-3" style="font-weight:500;">
        Drie schermen die het verhaal vertellen.
      </h2>
      <p class="text-aw-slate text-sm mb-10 aw-prose" style="font-weight:400;">
        Elk scherm is afkomstig uit een werkelijk uitgevoerde Relicore-implementatie.
      </p>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-4">

        <!-- Scherm 1: Assetregister / Procesboom -->
        <div class="datavlak datavlak--relicore">
          <div class="datavlak__kop px-4 py-3 flex items-center gap-2">
            <svg viewBox="0 0 40 40" width="16" height="16" aria-hidden="true">
              <circle cx="20" cy="20" r="16" fill="none" stroke="var(--aw-turquoise-light)" stroke-width="1.5"/>
              <circle cx="20" cy="20" r="4"  fill="none" stroke="var(--aw-turquoise-light)" stroke-width="1.5"/>
              <line x1="20" y1="4"  x2="20" y2="16" stroke="var(--aw-turquoise-light)" stroke-width="1.5"/>
              <line x1="20" y1="24" x2="20" y2="36" stroke="var(--aw-turquoise-light)" stroke-width="1.5"/>
              <line x1="4"  y1="20" x2="16" y2="20" stroke="var(--aw-turquoise-light)" stroke-width="1.5"/>
              <line x1="24" y1="20" x2="36" y2="20" stroke="var(--aw-turquoise-light)" stroke-width="1.5"/>
            </svg>
            <span class="text-white text-xs tracking-wide" style="font-weight:500;">Relicore</span>
          </div>
          <div class="flex border-b border-aw-line text-xs overflow-x-auto">
            {["Importeren","Stamdata","Assetregister","Data Kwaliteit"].map((t, i) => (
              <span class={`px-3 py-2.5 whitespace-nowrap flex-shrink-0
                ${i === 2
                  ? 'text-aw-navy border-b-2 border-aw-turquoise'
                  : 'text-aw-slate border-b-2 border-transparent'}`}
                    style="font-weight: i === 2 ? 500 : 400;">{t}</span>
            ))}
          </div>
          <div class="p-4">
            <p class="text-xs uppercase tracking-[0.12em] text-aw-slate mb-3" style="font-weight:500;">Procesboom</p>
            <div class="space-y-1 text-xs">
              <div class="flex items-center gap-2 px-2 py-1.5 text-aw-ink">
                <span class="text-aw-slate">▾</span> Enkhuizen
                <span class="text-xs px-1.5 py-0.5 rounded bg-aw-navy text-white ml-auto">SITE</span>
              </div>
              <div class="flex items-center gap-2 px-4 py-1.5 text-aw-ink">
                <span class="text-aw-slate">▾</span> PRODUCTIE
                <span class="text-xs px-1.5 py-0.5 rounded bg-green-100 text-green-800 ml-auto">FUNCTIE</span>
              </div>
              <div class="flex items-center gap-2 px-8 py-1.5 rounded bg-blue-50 text-blue-700">
                <span>·</span> Verpakking
                <span class="text-xs px-1.5 py-0.5 rounded bg-aw-wolk text-aw-slate ml-auto">SUB</span>
              </div>
              <div class="flex items-center gap-2 px-8 py-1.5 text-aw-slate">
                <span>·</span> Zaadopslag
                <span class="text-xs px-1.5 py-0.5 rounded bg-aw-wolk text-aw-slate ml-auto">SUB</span>
              </div>
              <div class="flex items-center gap-2 px-4 py-1.5 text-aw-ink">
                <span class="text-aw-slate">▾</span> UTILITIES
                <span class="text-xs px-1.5 py-0.5 rounded bg-green-100 text-green-800 ml-auto">FUNCTIE</span>
              </div>
            </div>
            <div class="mt-3 p-2.5 bg-aw-wolk rounded-aw">
              <p class="text-xs text-aw-slate">370 procesfuncties · 500 equipment</p>
              <p class="text-xs text-amber-700 mt-0.5">496 nog te positioneren</p>
            </div>
          </div>
        </div>

        <!-- Scherm 2: Data Kwaliteit -->
        <div class="datavlak datavlak--relicore">
          <div class="datavlak__kop px-4 py-3 flex items-center gap-2">
            <svg viewBox="0 0 40 40" width="16" height="16" aria-hidden="true">
              <circle cx="20" cy="20" r="16" fill="none" stroke="var(--aw-turquoise-light)" stroke-width="1.5"/>
              <circle cx="20" cy="20" r="4"  fill="none" stroke="var(--aw-turquoise-light)" stroke-width="1.5"/>
              <line x1="20" y1="4"  x2="20" y2="16" stroke="var(--aw-turquoise-light)" stroke-width="1.5"/>
              <line x1="20" y1="24" x2="20" y2="36" stroke="var(--aw-turquoise-light)" stroke-width="1.5"/>
              <line x1="4"  y1="20" x2="16" y2="20" stroke="var(--aw-turquoise-light)" stroke-width="1.5"/>
              <line x1="24" y1="20" x2="36" y2="20" stroke="var(--aw-turquoise-light)" stroke-width="1.5"/>
            </svg>
            <span class="text-white text-xs tracking-wide" style="font-weight:500;">Relicore</span>
          </div>
          <div class="flex border-b border-aw-line text-xs overflow-x-auto">
            {["Importeren","Stamdata","Assetregister","Data Kwaliteit"].map((t, i) => (
              <span class={`px-3 py-2.5 whitespace-nowrap flex-shrink-0
                ${i === 3
                  ? 'text-aw-navy border-b-2 border-aw-turquoise'
                  : 'text-aw-slate border-b-2 border-transparent'}`}>{t}</span>
            ))}
          </div>
          <div class="p-4">
            <div class="grid grid-cols-3 gap-2 mb-4 bg-aw-wolk rounded-aw p-2.5">
              <div>
                <p class="text-xs text-aw-slate mb-0.5">Filter-match</p>
                <p class="text-sm text-aw-navy" style="font-weight:500;">23.852</p>
              </div>
              <div>
                <p class="text-xs text-aw-slate mb-0.5">Completeness</p>
                <p class="text-sm text-aw-navy" style="font-weight:500;">40%</p>
              </div>
              <div>
                <p class="text-xs text-aw-slate mb-0.5">Ongekoppeld</p>
                <p class="text-sm text-amber-700" style="font-weight:500;">23.848</p>
              </div>
            </div>
            <table class="w-full text-xs">
              <thead>
                <tr class="border-b border-aw-line">
                  <th class="text-left py-1.5 text-aw-slate pr-2" style="font-weight:500;">Omschrijving</th>
                  <th class="py-1.5 text-aw-slate text-center" style="font-weight:500;">FK</th>
                  <th class="py-1.5 text-aw-slate text-right" style="font-weight:500;">%</th>
                </tr>
              </thead>
              <tbody>
                {[
                  { naam: "Koelkast economic Bosch", fk: [1,0,1,0,1], pct: "80%" },
                  { naam: "Compressor",              fk: [1,0,0,0,0], pct: "40%" },
                  { naam: "Slootpomp zelfaanzuigend",fk: [1,0,1,0,0], pct: "60%" },
                  { naam: "Bassinwater aanvoerpomp", fk: [1,0,1,0,0], pct: "60%" },
                ].map((r) => (
                  <tr class="border-b border-aw-line">
                    <td class="py-2 pr-2 text-aw-navy truncate max-w-24">{r.naam}</td>
                    <td class="py-2 text-center">
                      <div class="flex gap-0.5 justify-center">
                        {r.fk.map((v) => (
                          <span class={`w-2 h-2 rounded-full ${v ? 'bg-aw-turquoise' : 'bg-aw-line'}`}></span>
                        ))}
                      </div>
                    </td>
                    <td class="py-2 text-aw-turquoise text-right" style="font-weight:500;">{r.pct}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>

        <!-- Scherm 3: Stamdata -->
        <div class="datavlak datavlak--relicore">
          <div class="datavlak__kop px-4 py-3 flex items-center gap-2">
            <svg viewBox="0 0 40 40" width="16" height="16" aria-hidden="true">
              <circle cx="20" cy="20" r="16" fill="none" stroke="var(--aw-turquoise-light)" stroke-width="1.5"/>
              <circle cx="20" cy="20" r="4"  fill="none" stroke="var(--aw-turquoise-light)" stroke-width="1.5"/>
              <line x1="20" y1="4"  x2="20" y2="16" stroke="var(--aw-turquoise-light)" stroke-width="1.5"/>
              <line x1="20" y1="24" x2="20" y2="36" stroke="var(--aw-turquoise-light)" stroke-width="1.5"/>
              <line x1="4"  y1="20" x2="16" y2="20" stroke="var(--aw-turquoise-light)" stroke-width="1.5"/>
              <line x1="24" y1="20" x2="36" y2="20" stroke="var(--aw-turquoise-light)" stroke-width="1.5"/>
            </svg>
            <span class="text-white text-xs tracking-wide" style="font-weight:500;">Relicore</span>
          </div>
          <div class="flex border-b border-aw-line text-xs overflow-x-auto">
            {["Importeren","Stamdata","Assetregister","Data Kwaliteit"].map((t, i) => (
              <span class={`px-3 py-2.5 whitespace-nowrap flex-shrink-0
                ${i === 1
                  ? 'text-aw-navy border-b-2 border-aw-turquoise'
                  : 'text-aw-slate border-b-2 border-transparent'}`}>{t}</span>
            ))}
          </div>
          <div class="p-4">
            <p class="text-xs uppercase tracking-[0.12em] text-aw-slate mb-3" style="font-weight:500;">Stamdata werkbanken</p>
            <div class="grid grid-cols-2 gap-1.5">
              {[
                { naam: "Assetsoorten",    n: "109",   actief: true  },
                { naam: "Naamgeving",      n: "v1",    actief: true  },
                { naam: "Vakgroepen",      n: "30",    actief: true  },
                { naam: "Leveranciers",    n: "1.312", actief: true  },
                { naam: "Ruimtes",         n: "1.565", actief: true  },
                { naam: "Afdelingen",      n: "73",    actief: true  },
                { naam: "Kostenplaatsen",  n: "326",   actief: true  },
                { naam: "Storingsoorzaken",n: "—",     actief: false },
              ].map((w) => (
                <div class={`p-2 rounded border text-xs ${w.actief ? 'border-aw-line bg-white' : 'border-aw-line bg-aw-wolk opacity-60'}`}>
                  <p class="text-aw-navy mb-0.5" style="font-weight:500;">{w.naam}</p>
                  <p class="text-aw-slate">{w.n} · {w.actief ? 'actief' : 'binnenkort'}</p>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>


  <!-- ⑥ WAT Relicore OPLEVERT -->
  <section class="bg-white py-20">
    <div class="aw-container aw-split">
      <div>
      <p class="text-aw-turquoise text-xs uppercase tracking-[0.12em] mb-4" style="font-weight:500;">Wat Relicore oplevert</p>
      <h2 class="text-2xl md:text-3xl leading-snug text-aw-navy mb-10 max-w-lg" style="font-weight:500;">
        Niet een schoner register.<br />Een gemeenschappelijke taal.
      </h2>
      </div>
      <div class="divide-y divide-aw-line">
        {[
          { kop: "Gedeelde assetlogica",       tekst: "Een procesfunctie-gebaseerde structuur die expliciet maakt wat er moet werken, wat er staat, en hoe die twee zich verhouden." },
          { kop: "Herleidbare beslissingen",   tekst: "Vervangings-, investerings- en onderhoudsbeslissingen die niet op gevoel genomen worden — maar op een structuur die iedereen kan lezen en betwisten." },
          { kop: "Bestuurbaar risico",          tekst: "Criticality, eigenaarschap en keuringen gekoppeld aan assets — zodat risico niet alleen aanwezig is, maar ook bestuurbaar." },
          { kop: "Borging in de organisatie",  tekst: "Een exporteerbare structuur die teruggaat naar het CMMS — zodat de assetlogica ook operationeel werkt en niet opnieuw opgebouwd moet worden." },
        ].map((punt, i) => (
          <div class="flex items-start gap-5 py-5">
            <span class="text-aw-turquoise text-xs flex-shrink-0 mt-0.5" style="font-weight:500;">{i + 1}</span>
            <div>
              <p class="text-aw-navy text-sm mb-1" style="font-weight:500;">{punt.kop}</p>
              <p class="text-aw-slate text-sm leading-relaxed" style="font-weight:400;">{punt.tekst}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ⑦ INTEGRATIES -->
  <section class="bg-aw-wolk py-20">
    <div class="aw-container aw-split">
      <div>
      <p class="text-aw-navy text-xs uppercase tracking-[0.12em] mb-4" style="font-weight:500;">Integraties</p>
      <h2 class="text-2xl md:text-3xl leading-snug text-aw-navy mb-3" style="font-weight:500;">
        Werkt met uw bestaande CMMS.
      </h2>
      <p class="text-aw-slate text-sm mb-10 aw-prose" style="font-weight:400;">
        Relicore vervangt uw CMMS niet. Import en export zijn bewuste stappen — engineering logica gaat altijd boven administratief gemak.
      </p>
      </div>
      <div class="grid grid-cols-2 gap-3">
        {[
          { naam: "Ultimo",    status: "Actief",      live: true  },
          { naam: "SAP PM",    status: "In planning", live: false },
          { naam: "Maximo",    status: "In planning", live: false },
          { naam: "Infor EAM", status: "In planning", live: false },
        ].map((int) => (
          <div class={`p-4 text-center rounded-aw
            ${int.live
              ? 'border border-aw-turquoise bg-aw-mist'
              : 'border border-aw-line bg-white'}`}>
            <p class={`text-sm mb-1 ${int.live ? 'text-aw-navy' : 'text-aw-slate'}`}
               style="font-weight:500;">{int.naam}</p>
            <p class={`text-xs uppercase tracking-wide
              ${int.live ? 'text-aw-navy' : 'text-aw-slate'}`}
               style="font-weight:500;">{int.status}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ⑧ CTA -->
  <section class="bg-aw-deep text-white py-20">
    <div class="aw-container text-center">
      <h2 class="text-2xl md:text-3xl leading-snug text-white mb-4 max-w-lg mx-auto"
          style="font-weight:500;">
        Van assetregister naar gedeelde assetlogica.
      </h2>
      <p class="text-white/72 text-base leading-relaxed mb-10 max-w-md mx-auto"
         style="font-weight:400;">
        In een eerste gesprek bekijken we hoe Relicore aansluit op uw huidige CMMS — en welke beslissingen daarna anders genomen kunnen worden.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="https://relicore.app"
           target="_blank" rel="noopener noreferrer"
           class="aw-btn-primary inline-flex px-8 py-4">
          Bekijk pilotomgeving
        </a>
        <a href="/contact"
           class="aw-btn-secondary-dark inline-flex px-8 py-4">
          Plan een gesprek
        </a>
      </div>
    </div>
  </section>

</BaseLayout>
