---
export interface Props {
  title: string;
  description?: string;
  ogImage?: string;
}
const {
  title,
  description = 'AssetWize ontwerpt het systeem waarmee asset-intensieve organisaties grip krijgen op risico, prestaties, investeringen en continuïteit.',
  ogImage = '/brand/og-image.png',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? 'https://www.assetwize.nl');
const fullTitle = `${title} | AssetWize`;

const navItems = [
  { href: '/compass', label: 'Compass' },
  { href: '/atlas', label: 'Atlas' },
  { href: '/relicore', label: 'Relicore' },
  { href: '/waarom', label: 'Waarom AssetWize' },
];
const isActive = (href: string) => Astro.url.pathname === href || Astro.url.pathname.startsWith(`${href}/`);
---
<!DOCTYPE html>
<html lang="nl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalURL} />
  <title>{fullTitle}</title>

  <!-- Favicons -->
  <link rel="icon" type="image/x-icon" href="/brand/favicon.ico" sizes="16x16 32x32 48x48" />
  <link rel="icon" type="image/svg+xml" href="/brand/favicon.svg" />
  <link rel="icon" type="image/png" sizes="48x48" href="/brand/favicon-48.png" />
  <link rel="icon" type="image/png" sizes="32x32" href="/brand/favicon-32.png" />
  <link rel="icon" type="image/png" sizes="16x16" href="/brand/favicon-16.png" />
  <link rel="apple-touch-icon" sizes="180x180" href="/brand/apple-touch-icon.png" />
  <link rel="icon" type="image/png" sizes="192x192" href="/brand/android-chrome-192.png" />
  <link rel="icon" type="image/png" sizes="512x512" href="/brand/android-chrome-512.png" />
  <meta name="theme-color" content="#FFFFFF" />

  <!-- Open Graph (Facebook, WhatsApp, LinkedIn) -->
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={new URL(ogImage, Astro.site ?? 'https://www.assetwize.nl')} />
  <meta property="og:locale" content="nl_NL" />
  <meta property="og:site_name" content="AssetWize" />

  <!-- Twitter / X Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={fullTitle} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={new URL(ogImage, Astro.site ?? 'https://www.assetwize.nl')} />

  <!-- Robots -->
  <meta name="robots" content="index, follow" />

  <!-- Google Search Console verificatie -->
  <!-- Vervang VERIFICATIE_CODE door de code uit search.google.com/search-console -->
  <!-- <meta name="google-site-verification" content="VERIFICATIE_CODE" /> -->

  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
  <style>
    /* Pagina-achtergrond wordt bepaald door de eerste sectie, niet door body */
    html, body { background-color: #ffffff; margin: 0; }
    /* Font-weight override — Inter 500 expliciet forceren */
    .fw-medium { font-weight: 500 !important; }
    .fw-normal { font-weight: 400 !important; }
  </style>

  <!-- Structured data — Organization -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": "AssetWize",
    "url": "https://www.assetwize.nl",
    "logo": "https://www.assetwize.nl/brand/android-chrome-512.png",
    "description": "AssetWize ontwerpt het systeem waarmee asset-intensieve organisaties grip krijgen op risico, prestaties, investeringen en continuïteit.",
    "sameAs": [
      "https://nl.linkedin.com/in/dimitryvandort"
    ]
  })}></script>
</head>
<body class="text-aw-ink font-sans">

  <!-- Header — §10.1: wit, onderrand 1 px Lijn, logo 05 licht, nav Inkt, actieve link turquoise -->
  <header class="sticky top-0 z-50 bg-white border-b border-aw-line">
    <nav class="aw-container py-3 flex items-center justify-between">
      <a href="/" class="flex items-center">
        <img src="/brand/assetwize-logo-licht.svg" alt="AssetWize" class="h-8 w-auto" />
      </a>
      <ul class="hidden md:flex gap-8 text-sm font-medium">
        {navItems.map(item => (
          <li>
            <a href={item.href}
               aria-current={isActive(item.href) ? 'page' : undefined}
               class={`aw-focus rounded-sm transition-colors ${isActive(item.href) ? 'text-aw-turquoise' : 'text-aw-ink hover:text-aw-turquoise'}`}>
              {item.label}
            </a>
          </li>
        ))}
      </ul>
      <!-- Knop primair — §10.2: turquoise, witte tekst, hoek 8 px, hover merk-navy -->
      <a href="/contact" class="hidden md:inline-flex px-4 py-2 bg-aw-turquoise text-white text-sm font-medium rounded-aw hover:bg-aw-navy transition-colors">
        Start het gesprek
      </a>
      <!-- Menuknop onder 768 px (TASK-010) -->
      <button type="button" id="menu-knop" class="md:hidden aw-focus -mr-2 p-2 text-aw-navy rounded-aw"
              aria-label="Menu" aria-expanded="false" aria-controls="mobiel-menu">
        <svg data-icoon="open" viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true">
          <path d="M4 7h16M4 12h16M4 17h16"/>
        </svg>
        <svg data-icoon="dicht" class="hidden" viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true">
          <path d="M6 6l12 12M18 6L6 18"/>
        </svg>
      </button>
    </nav>
    <!-- Mobiel paneel: wit, 1 px Lijn, dezelfde links als de desktopnavigatie -->
    <div id="mobiel-menu" class="md:hidden bg-white border-t border-aw-line" hidden>
      <ul class="aw-container py-4 flex flex-col text-base font-medium">
        {navItems.map(item => (
          <li>
            <a href={item.href}
               aria-current={isActive(item.href) ? 'page' : undefined}
               class={`aw-focus block py-3 rounded-aw ${isActive(item.href) ? 'text-aw-turquoise' : 'text-aw-ink'}`}>
              {item.label}
            </a>
          </li>
        ))}
        <li class="pt-3 pb-2">
          <a href="/contact" class="aw-btn-primary aw-focus inline-flex px-4 py-2.5 text-sm">
            Start het gesprek
          </a>
        </li>
      </ul>
    </div>
  </header>
  <script is:inline>
    (() => {
      const knop = document.getElementById('menu-knop');
      const paneel = document.getElementById('mobiel-menu');
      if (!knop || !paneel) return;
      const zet = (open) => {
        paneel.hidden = !open;
        knop.setAttribute('aria-expanded', String(open));
        knop.querySelector('[data-icoon="open"]').classList.toggle('hidden', open);
        knop.querySelector('[data-icoon="dicht"]').classList.toggle('hidden', !open);
      };
      knop.addEventListener('click', () => zet(paneel.hidden));
      paneel.addEventListener('click', (e) => { if (e.target.closest('a')) zet(false); });
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && !paneel.hidden) { zet(false); knop.focus(); }
      });
      matchMedia('(min-width: 768px)').addEventListener('change', (e) => { if (e.matches) zet(false); });
    })();
  </script>

  <main>
    <slot />
  </main>

  <!-- Footer — §10.1: diep navy, logo 06 donker met kernbegrippen (alleen op #071A30), links wit 72 % -->
  <footer class="bg-aw-deep text-white">
    <div class="aw-container py-10 grid md:grid-cols-3 gap-8 text-sm">
      <div>
        <img src="/brand/assetwize-logo-tagline-donker.svg" alt="AssetWize. Insight. Alignment. Impact." class="w-[300px] h-auto" />
      </div>
      <div>
        <div class="font-medium text-white mb-3">Producten</div>
        <ul class="space-y-2 text-white/72">
          <li><a href="/compass" class="hover:text-white transition-colors">Compass by AssetWize</a></li>
          <li><a href="/atlas" class="hover:text-white transition-colors">Atlas by AssetWize</a></li>
          <li><a href="/relicore" class="hover:text-white transition-colors">Relicore by AssetWize</a></li>
        </ul>
      </div>
      <div>
        <div class="font-medium text-white mb-3">Bedrijf</div>
        <ul class="space-y-2 text-white/72">
          <li><a href="/waarom" class="hover:text-white transition-colors">Waarom AssetWize</a></li>
          <li><a href="/contact" class="hover:text-white transition-colors">Contact</a></li>
        </ul>
      </div>
    </div>
    <div class="border-t border-white/10 aw-container py-4 text-xs text-white/72">
      &copy; {new Date().getFullYear()} AssetWize Software Solutions
    </div>
  </footer>

</body>
</html>
