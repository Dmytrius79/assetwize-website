---
export interface Props {
  title: string;
  description?: string;
  ogImage?: string;
}
const {
  title,
  description = 'AssetWize ontwerpt het systeem waarmee asset-intensieve organisaties grip krijgen op risico, prestaties, investeringen en continuïteit.',
  ogImage = '/brand/og-image.png',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? 'https://www.assetwize.nl');
const fullTitle = `${title} | AssetWize`;
---
<!DOCTYPE html>
<html lang="nl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalURL} />
  <title>{fullTitle}</title>

  <!-- Favicons -->
  <link rel="icon" type="image/x-icon" href="/brand/favicon.ico" sizes="16x16 32x32 48x48" />
  <link rel="icon" type="image/svg+xml" href="/brand/favicon.svg" />
  <link rel="icon" type="image/png" sizes="48x48" href="/brand/favicon-48.png" />
  <link rel="icon" type="image/png" sizes="32x32" href="/brand/favicon-32.png" />
  <link rel="icon" type="image/png" sizes="16x16" href="/brand/favicon-16.png" />
  <link rel="apple-touch-icon" sizes="180x180" href="/brand/apple-touch-icon.png" />
  <link rel="icon" type="image/png" sizes="192x192" href="/brand/android-chrome-192.png" />
  <link rel="icon" type="image/png" sizes="512x512" href="/brand/android-chrome-512.png" />
  <meta name="theme-color" content="#071A30" />

  <!-- Open Graph (Facebook, WhatsApp, LinkedIn) -->
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={new URL(ogImage, Astro.site ?? 'https://www.assetwize.nl')} />
  <meta property="og:locale" content="nl_NL" />
  <meta property="og:site_name" content="AssetWize" />

  <!-- Twitter / X Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={fullTitle} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={new URL(ogImage, Astro.site ?? 'https://www.assetwize.nl')} />

  <!-- Robots -->
  <meta name="robots" content="index, follow" />

  <!-- Google Search Console verificatie -->
  <!-- Vervang VERIFICATIE_CODE door de code uit search.google.com/search-console -->
  <!-- <meta name="google-site-verification" content="VERIFICATIE_CODE" /> -->

  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
  <style>
    /* Pagina-achtergrond wordt bepaald door de eerste sectie, niet door body */
    html, body { background-color: #ffffff; margin: 0; }
    /* Font-weight override — Inter 500 expliciet forceren */
    .fw-medium { font-weight: 500 !important; }
    .fw-normal { font-weight: 400 !important; }
  </style>

  <!-- Structured data — Organization -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": "AssetWize",
    "url": "https://www.assetwize.nl",
    "logo": "https://www.assetwize.nl/brand/android-chrome-512.png",
    "description": "AssetWize ontwerpt het systeem waarmee asset-intensieve organisaties grip krijgen op risico, prestaties, investeringen en continuïteit.",
    "sameAs": [
      "https://nl.linkedin.com/in/dimitryvandort"
    ]
  })}></script>
</head>
<body class="text-gray-900 font-sans">

  <header class="sticky top-0 z-50 bg-gray-50 shadow-sm">
    <nav class="aw-container py-3 flex items-center justify-between">
      <a href="/" class="flex items-center">
        <img src="/brand/assetwize-logo-licht.svg" alt="AssetWize" class="h-8 lg:h-[50px] w-auto" />
      </a>
      <ul class="hidden md:flex gap-8 text-sm font-medium text-gray-600">
        <li><a href="/compass" class="hover:text-teal-700 transition-colors">Compass</a></li>
        <li><a href="/atlas" class="hover:text-amber-700 transition-colors" style="color:inherit;">Atlas</a></li>
        <li><a href="/relicore" class="hover:text-teal-700 transition-colors">Relicore</a></li>
        <li><a href="/waarom" class="hover:text-teal-700 transition-colors">Waarom AssetWize</a></li>
      </ul>
      <a href="/contact" class="px-4 py-2 bg-teal-700 text-white text-sm font-medium rounded-lg hover:bg-teal-800 transition-colors">
        Start het gesprek
      </a>
    </nav>
  </header>

  <main>
    <slot />
  </main>

  <footer class="bg-aw-deep text-white">
    <div class="aw-container py-10 grid md:grid-cols-3 gap-8 text-sm">
      <div>
        <img src="/brand/assetwize-logo-tagline-donker.svg" alt="AssetWize" class="w-[300px] max-w-full h-auto mb-2" />
      </div>
      <div>
        <div class="font-medium text-gray-300 mb-3">Producten</div>
        <ul class="space-y-2 text-gray-400">
          <li><a href="/compass" class="hover:text-white transition-colors">Compass by AssetWize</a></li>
          <li><a href="/atlas" class="hover:text-white transition-colors">Atlas by AssetWize</a></li>
          <li><a href="/relicore" class="hover:text-white transition-colors">Relicore by AssetWize</a></li>
        </ul>
      </div>
      <div>
        <div class="font-medium text-gray-300 mb-3">Bedrijf</div>
        <ul class="space-y-2 text-gray-400">
          <li><a href="/waarom" class="hover:text-white transition-colors">Waarom AssetWize</a></li>
          <li><a href="/contact" class="hover:text-white transition-colors">Contact</a></li>
        </ul>
      </div>
    </div>
    <div class="border-t border-gray-800 aw-container py-4 text-xs text-gray-500">
      &copy; {new Date().getFullYear()} AssetWize Software Solutions
    </div>
  </footer>

</body>
</html>
